ENVIRONMENT=development
# OpenRouter API key for real-time AI predictions
# Get one at: https://openrouter.ai
OPENROUTER_API_KEY=

# Google Gemini API Key (Direct API call with automatic fallback)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=

# Weather API key for match-day conditions (WeatherAPI.com)
# Get one at: https://www.weatherapi.com
# If left blank, the system falls back to deterministic synthetic weather
WEATHER_API_KEY=


